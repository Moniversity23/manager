{
  "name": "the-gaffer",
  "version": "6.0.0",
  "description": "The Gaffer — Modern Football Management Game",
  "main": "src/server.js",
  "scripts": {
    "start": "node scripts/build-web.js && node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "node scripts/build-web.js",
    "lint": "eslint src test",
    "test": "node scripts/build-web.js && eslint src test && vitest run",
    "soak": "node scripts/soak.js",
    "build:anim": "node scripts/anim/build-footballer.js",
    "inspect:anim": "node scripts/anim/inspect.js assets/animations/source/mesh2motion/model.glb assets/animations/source/mesh2motion/animations --out assets/animations/processed/inspect-mesh2motion.json"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "mongodb": "^6.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "nodemon": "^3.0.2",
    "three": "^0.170.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18"
  }
}
